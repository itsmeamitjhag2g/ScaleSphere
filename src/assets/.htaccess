# Static files. The root .htaccess maps /css, /js, /images and the icons here;
# this overrides the "deny all" in src/.htaccess for this folder only.
Options -Indexes

<IfModule mod_authz_core.c>
  Require all granted
  <FilesMatch "(^\.|\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$)">
    Require all denied
  </FilesMatch>
</IfModule>
