# Social profiles shown in the footer and in schema.org sameAs.
# Leave a value empty to hide that icon.
SOCIAL_FACEBOOK=
SOCIAL_TWITTER=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
