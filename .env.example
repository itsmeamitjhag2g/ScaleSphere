# Certifications ScaleSphere itself holds (shown in the footer). Leave empty to hide.
# Example: SITE_CERTIFICATIONS="ISO 9001:2015"
SITE_CERTIFICATIONS=

# About page numbers. Leave empty to hide; only use figures you can back up.
STAT_PROJECTS=
STAT_TEAM=
STAT_YEARS=
