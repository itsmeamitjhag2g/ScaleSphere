# ScaleSphere — copy to .env and fill real values
SITE_NAME=ScaleSphere
SITE_TAGLINE=Scale Smarter. Grow Further.
SITE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
SITE_EMAIL=info@scalesphere.com
SITE_PHONE=+91 8884 739 988
SITE_ADDRESS=Kota, Rajasthan, India
LIVE_ASSETS=https://www.techasoft.com
NODE_ENV=development

# SMTP (PHPMailer) — credentials for the SENDING mailbox
# Gmail example: smtp.gmail.com + App Password (not your normal login password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sending-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM=your-sending-email@gmail.com
MAIL_FROM_NAME=ScaleSphere

# Inbox that receives contact form submissions
MAIL_TO=aj8751045@gmail.com