# Copy this file to .env and fill in real values. Never commit .env.
# Every key is explained in README.md, section 3.

# ---------------------------------------------------------------- site
# development locally, production on the live server
APP_ENV=development
# Full public URL, no trailing slash
SITE_URL=http://localhost:3000
SITE_NAME=ScaleSphere
SITE_TAGLINE="Scale Smarter. Grow Further."
SITE_EMAIL=info@your-domain.com
SITE_PHONE="+91 90000 00000"
SITE_ADDRESS="Kota, Rajasthan, India"
SITE_CERTIFICATIONS=

# About page counters (0 hides them)
STAT_PROJECTS=0
STAT_TEAM=0
STAT_YEARS=0

# Social profiles (footer icons + schema). Leave a value empty to hide that icon.
SOCIAL_FACEBOOK=
SOCIAL_TWITTER=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=

# 1 only behind a proxy/CDN that terminates HTTPS
TRUST_PROXY=

# ---------------------------------------------------------------- contact form email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# tls for 587, ssl for 465
MAIL_ENCRYPTION=tls
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=ScaleSphere Website
# Inbox that receives contact form messages
MAIL_TO=info@your-domain.com

# ---------------------------------------------------------------- blog admin
# Admin URL: /blog/<BLOG_ADMIN_PATH>/login  (8-64 chars: letters, numbers, - or _)
BLOG_ADMIN_PATH=
BLOG_CREDENTIAL_EMAIL=you@your-domain.com
# Plain password (14+ characters) OR a password_hash() value below
BLOG_CREDENTIAL_PASSWORD=
BLOG_CREDENTIAL_PASSWORD_HASH=
